@model Conta
@{
    ViewData["Title"] = "Abrir conta";
}
<h1>Abrir conta</h1>
<form asp-action="Create" method="post" class="formulario">
    <partial name="_Form" model="Model" />
    <div class="acoes">
        <button type="submit" class="botao">Abrir conta</button>
        <a asp-action="Index" class="botao botao-sec">Cancelar</a>
    </div>
</form>
