@model Conta
<div asp-validation-summary="ModelOnly" class="erro"></div>
<div class="campo">
    <label asp-for="ClienteId"></label>
    <select asp-for="ClienteId" asp-items="ViewBag.Clientes">
        <option value="0">Escolha o titular</option>
    </select>
    <span asp-validation-for="ClienteId" class="erro"></span>
</div>
<div class="campo-duplo">
    <div class="campo">
        <label asp-for="Agencia"></label>
        <input asp-for="Agencia" inputmode="numeric" />
        <span asp-validation-for="Agencia" class="erro"></span>
    </div>
    <div class="campo">
        <label asp-for="Numero"></label>
        <input asp-for="Numero" />
        <span asp-validation-for="Numero" class="erro"></span>
    </div>
</div>
<div class="campo">
    <label asp-for="Tipo"></label>
    <select asp-for="Tipo">
        @foreach (var t in Conta.TiposValidos)
        {
            <option value="@t">@Formato.Tipo(t)</option>
        }
    </select>
    <span asp-validation-for="Tipo" class="erro"></span>
</div>
<div class="campo">
    <label asp-for="Saldo">Saldo (R$)</label>
    <input asp-for="Saldo" type="number" step="0.01" min="0" />
    <span asp-validation-for="Saldo" class="erro"></span>
</div>
