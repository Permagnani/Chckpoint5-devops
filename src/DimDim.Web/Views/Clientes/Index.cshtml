@model IEnumerable<Cliente>
@{
    ViewData["Title"] = "Clientes";
}
<div class="cabecalho">
    <h1>Clientes</h1>
    <a class="botao" asp-action="Create">Cadastrar cliente</a>
</div>

<form method="get" class="busca" role="search">
    <label for="busca" class="sr-only">Buscar por nome ou CPF</label>
    <input id="busca" name="busca" value="@ViewData["Busca"]" placeholder="Buscar por nome ou CPF" />
    <button class="botao botao-sec" type="submit">Buscar</button>
</form>

@if (!Model.Any())
{
    <p class="vazio">Nenhum cliente encontrado. <a asp-action="Create">Cadastre o primeiro.</a></p>
}
else
{
    <div class="tabela-wrap">
        <table>
            <thead><tr><th>Id</th><th>Nome</th><th>CPF</th><th>E-mail</th><th class="num">Contas</th><th></th></tr></thead>
            <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.Id</td>
                    <td><a asp-action="Details" asp-route-id="@c.Id">@c.Nome</a></td>
                    <td>@Formato.Cpf(c.Cpf)</td>
                    <td>@c.Email</td>
                    <td class="num">@c.Contas.Count</td>
                    <td class="linha-acoes">
                        <a asp-action="Edit" asp-route-id="@c.Id">Editar</a>
                        <a asp-action="Delete" asp-route-id="@c.Id" class="perigo">Excluir</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
