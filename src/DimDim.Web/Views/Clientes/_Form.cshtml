@model Cliente
<div asp-validation-summary="ModelOnly" class="erro"></div>
<div class="campo">
    <label asp-for="Nome"></label>
    <input asp-for="Nome" autocomplete="name" />
    <span asp-validation-for="Nome" class="erro"></span>
</div>
<div class="campo">
    <label asp-for="Cpf"></label>
    <input asp-for="Cpf" inputmode="numeric" maxlength="11" placeholder="Só números" />
    <span asp-validation-for="Cpf" class="erro"></span>
</div>
<div class="campo">
    <label asp-for="Email"></label>
    <input asp-for="Email" type="email" autocomplete="email" />
    <span asp-validation-for="Email" class="erro"></span>
</div>
<div class="campo">
    <label asp-for="Telefone"></label>
    <input asp-for="Telefone" autocomplete="tel" />
    <span asp-validation-for="Telefone" class="erro"></span>
</div>
